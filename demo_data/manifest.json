    "observations.h5": {
     "sha256": "dc48a8d8bb28948be060fd729719189377a23ff4a8dfef6c20a59d8e0d4078c4",
     "bytes": 295876,
     "fields": {
      "Z_dd": {
       "shape": [
        64,
        1,
        16,
        32,
        3
       ],
       "dtype": "float32",
       "per_episode": true,
       "description": "[E, P0, delay 16, Doppler 32, 3] observation stack of the latest fed-back CSI field gamma: ch0 = clip(10 log10 gamma, -30, 60) / 20; ch1 = ln(1 + gamma); ch2 = -(ch1 - mean) / std over the 512 bins (0 if std < 1e-4); axis 1 = P0 index (size 1 for a main corpus, one entry per p0_grid_db value for a sweep corpus)",
       "unit": "1"
      },
      "beam_phase_ms": {
       "shape": [
        64,
        2
       ],
       "dtype": "int16",
       "per_episode": true,
       "description": "[E, 2] re-aim schedule of the reference transmitter (column 0) and receiver (column 1): end s re-aims at subframes beam_phase_ms[s] + 1000 k after an initial aim at subframe 0",
       "unit": "ms"
      },
      "csi_age_ms": {
       "shape": [
        64,
        3
       ],
       "dtype": "int16",
       "per_episode": true,
       "description": "[E, 3] age of each fed-back CSI field at the decision subframe; the latest is 120, 240, 360 or 480",
       "unit": "ms"
      },
      "csi_field_db": {
       "shape": [
        64,
        1,
        3,
        16,
        32
       ],
       "dtype": "float32",
       "per_episode": true,
       "description": "[E, P0, 3, delay 16, Doppler 32] fed-back CSI fields: the measured per-bin post-LMMSE SINR fed back as one value per block of one delay row and 8 Doppler bins (block mean dB; strongest block 0.5 dB steps on [-23, 40] dB, the others 2 dB steps down to 30 dB below it), expanded to the grid; index 0 = latest, then 120 ms and 240 ms older",
       "unit": "dB"
      },
      "mu_p": {
       "shape": [
        64,
        1
       ],
       "dtype": "int8",
       "per_episode": true,
       "description": "[E, P0] protocol MCS (0..22): the highest MCS whose EESM of the latest fed-back CSI, at that MCS's beta (EESM_BETA_TABLE2), reaches its BLER-0.1 threshold gamma_sel_db; MCS 0 if none",
       "unit": "1"
      },
      "p0_db": {
       "shape": [
        64,
        1
       ],
       "dtype": "float32",
       "per_episode": true,
       "description": "[E, P0] reference-link power offset (physics.p0_meaning in manifest.json): the reference transmitter's own power setting",
       "unit": "dB"
      },
      "z_nav": {
       "shape": [
        64,
        13
       ],
       "dtype": "float32",
       "per_episode": true,
       "description": "[E, 13] navigation at the decision subframe: receiver-minus-transmitter position (3), transmitter velocity (3), receiver velocity (3), azimuth and elevation of the transmitter and receiver beam commands in force (4); world frame, azimuth from +x toward +y; navigation errors 1 m, 0.1 m/s per axis",
       "unit": "m, m/s, rad"
      }
     }
    },
